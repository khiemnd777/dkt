APP_ENV=development
# Optional locally. Production readiness requires both values and /api/health must report
# turnstileProtected: true before sharing the public room-creation URL.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional. Keep this value secret; the Worker serves only the matching verification path.
INDEXNOW_KEY=

# YouVersion and AI features stay disabled until the selected Bible license is approved.
SCRIPTURE_PROVIDER_ENABLED=false
AI_QUESTION_SUGGESTIONS_ENABLED=false
AI_AUTO_BALANCE_ENABLED=false
QUESTION_MEDIA_ENABLED=false
AI_MEDIA_ANALYSIS_ENABLED=false
YVP_ALLOWED_BIBLE_IDS=
YVP_APP_KEY=
OPENAI_API_KEY=
OPENAI_GENERATION_MODEL=gpt-5.6-terra
OPENAI_REVIEW_MODEL=gpt-5.6-sol
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
PROVENANCE_SIGNING_KEY=
GENERATION_ABUSE_HMAC_KEY=
QUESTION_MEDIA_SIGNING_KEY=
