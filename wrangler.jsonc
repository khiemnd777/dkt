{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "do-kinh-thanh-live",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-30",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "dokinhthanh.io.vn",
      "zone_name": "dokinhthanh.io.vn",
      "custom_domain": true
    },
    {
      "pattern": "www.dokinhthanh.io.vn",
      "zone_name": "dokinhthanh.io.vn",
      "custom_domain": true
    },
    {
      "pattern": "game.dokinhthanh.io.vn",
      "zone_name": "dokinhthanh.io.vn",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": [
      "/api/*",
      "/",
      "/index.html",
      "/app-shell.html",
      "/create*",
      "/join/*",
      "/play/*",
      "/host/*",
      "/screen/*",
      "/privacy*",
      "/sw.js",
      "/robots.txt",
      "/sitemap.xml",
      "/llms.txt",
      "/vi",
      "/vi/*",
      "/en",
      "/en/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOMS",
        "class_name": "GameRoom"
      },
      {
        "name": "GENERATION_GATES",
        "class_name": "GenerationGate"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoom"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["GenerationGate"]
    }
  ],
  "r2_buckets": [
    {
      "binding": "QUESTION_MEDIA",
      "bucket_name": "do-kinh-thanh-question-media",
      "preview_bucket_name": "do-kinh-thanh-question-media-preview"
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "TURNSTILE_EXPECTED_ACTION": "create-room",
    "TURNSTILE_GENERATION_ACTION": "question-generation",
    "SCRIPTURE_PROVIDER_ENABLED": "true",
    "AI_QUESTION_SUGGESTIONS_ENABLED": "false",
    "AI_AUTO_BALANCE_ENABLED": "false",
    "QUESTION_MEDIA_ENABLED": "true",
    "AI_MEDIA_ANALYSIS_ENABLED": "false",
    "YVP_ALLOWED_BIBLE_IDS": "1638",
    "OPENAI_GENERATION_MODEL": "gpt-5.6-terra",
    "OPENAI_REVIEW_MODEL": "gpt-5.6-sol",
    "OPENAI_TRANSCRIPTION_MODEL": "gpt-transcribe"
  }
}
