{
  "name": "do-kinh-thanh-live",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build:site && WRANGLER_WRITE_LOGS=false vite",
    "build:site": "bun scripts/build-site.ts",
    "build:game": "WRANGLER_WRITE_LOGS=false vite build",
    "build": "bun run build:site && bun run build:game && bun scripts/finalize-build.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "bun run test:unit && bun run test:worker",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:e2e": "playwright test",
    "test:seo": "vitest run --config vitest.config.ts tests/unit/seo.test.ts",
    "test:lighthouse": "lhci autorun",
    "test:uat": "playwright test e2e/uat.spec.ts",
    "test:load": "bun scripts/load-test.ts",
    "smoke:production": "bun scripts/smoke-production.ts",
    "deploy": "bun run build && wrangler deploy",
    "check:free-tier": "bun scripts/check-free-tier.ts",
    "indexnow": "bun scripts/indexnow.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "latest",
    "@dnd-kit/sortable": "latest",
    "@dnd-kit/utilities": "latest",
    "@vite-pwa/assets-generator": "latest",
    "lucide-react": "latest",
    "qrcode.react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@cloudflare/vite-plugin": "latest",
    "@cloudflare/vitest-pool-workers": "latest",
    "@cloudflare/workers-types": "latest",
    "@playwright/test": "latest",
    "@lhci/cli": "^0.15.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.2",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "autoprefixer": "latest",
    "jsdom": "latest",
    "postcss": "latest",
    "sharp": "^0.33.5",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vite-plugin-pwa": "latest",
    "vitest": "latest",
    "wrangler": "latest"
  }
}
