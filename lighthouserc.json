{
  "ci": {
    "collect": {
      "startServerCommand": "bun run preview -- --host 127.0.0.1 --port 41732 --strictPort",
      "startServerReadyPattern": "Local:",
      "url": [
        "http://127.0.0.1:41732/vi/",
        "http://127.0.0.1:41732/en/",
        "http://127.0.0.1:41732/vi/tinh-nang/",
        "http://127.0.0.1:41732/en/guides/create-a-bible-quiz/",
        "http://127.0.0.1:41732/vi/cau-hoi-thuong-gap/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--headless --no-sandbox --disable-dev-shm-usage"
      }
    },
    "assert": {
      "aggregationMethod": "median",
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 1 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["error", { "maxNumericValue": 300 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lighthouse-results"
    }
  }
}
